name: Discord Release Announcer

on:
  push:
    branches:
      - main # Make sure this matches your default branch name
    paths:
      - 'swapper/text' # Only runs when THIS specific file is updated

jobs:
  post-to-discord:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Send Announcement to Discord
        env:
          DISCORD_WEBHOOK: ${{ secrets.DISCORD_WEBHOOK3 }}
          DOWNLOAD_LINK: "[Alphy Swapper.exe](https://raw.githubusercontent.com/AC-Storm-YT/alphy.github.io/refs/heads/main/swapper/Alphy%20Swapper.exe)"
        run: |
          # Read the raw text directly from the file in your repo
          MESSAGE=$(cat swapper/text)
          
          # Combine your text with the download link
          FULL_MESSAGE="$MESSAGE\n\n📥 **Download here:** $DOWNLOAD_LINK"
          
          # Safely package it into JSON (handles newlines and quotes automatically)
          JSON_PAYLOAD=$(jq -n --arg content "$FULL_MESSAGE" '{content: $content}')
          
          # Fire it off to Discord
          curl -H "Content-Type: application/json" \
               -X POST \
               -d "$JSON_PAYLOAD" \
               $DISCORD_WEBHOOK